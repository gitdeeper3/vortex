# تقارير Vortex (يمكن إضافة عينات يدوياً)
reports/daily/*
reports/weekly/*
reports/monthly/*
reports/archived/*

# استثناء: احتفظ بمجلدات التقارير الفارغة
!reports/daily/.gitkeep
!reports/weekly/.gitkeep  
!reports/monthly/.gitkeep
!reports/archived/.gitkeep

# ملفات نصية للتوثيق فقط
!reports/sample-*.txt

# مجلدات الاختبار المؤقتة
